# MongoDB Connection
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teachquest?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (comma separated if more than one, e.g. your Vercel URL)
CLIENT_URL=http://localhost:5173

# JWT Secret - use a long random string
JWT_SECRET=change_me

# OpenRouter API key for the AI assistant
OPENROUTER_API_KEY=
# Optional, any model id from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Gmail account used for allocation emails
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Used by `npm run seed:admin` to create the first admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change_me
